# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
LETTER_ENCRYPTION_KEY=your_64_char_hex_key_here

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=lettervault
DB_PASSWORD=your_db_password_here
DB_NAME=lettervault

# SMTP (leave blank to disable email — vault still works without it)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=Letter Vault <no-reply@your-domain.com>

# Public base URL (used in email links)
NEXT_PUBLIC_BASE_URL=https://letter-vault.saihtet.dev

# Secret for calling the daily cron endpoint (generate a random string)
CRON_SECRET=your_random_cron_secret_here
